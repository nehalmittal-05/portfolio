# ==============================================================================
# SERVER ENVIRONMENT VARIABLES (.env.example)
# ==============================================================================
# Copy this file to .env and configure your local or cloud settings.
# Do NOT commit your real .env file with production credentials to Git!
# ==============================================================================

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# Allowed Frontend Origins for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Mongoose)
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/mern_portfolio
#
# MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/mern_portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/mern_portfolio
